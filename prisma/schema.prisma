generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BusinessType {
  INDIVIDUAL
  REGISTERED_BUSINESS
  COOPERATIVE
  ARTISAN_GROUP
}

enum BusinessCategory {
  HANDLOOM
  JEWELLERY
  HANDICRAFTS
  APPAREL
  HOME_DECOR
  ORGANIC_PRODUCTS
  OTHER
}

enum ResearchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum BudgetReservationStatus {
  RESERVED
  SETTLED
  RELEASED
}

enum ExportRequirementCategory {
  BUSINESS_REGISTRATION
  EXPORT_REGISTRATION
  PRODUCT_CLASSIFICATION
  PRODUCT_COMPLIANCE
  DOCUMENTATION
  CUSTOMS
  PACKAGING_LABELING
  SHIPPING
}

enum ExportRequirementPriority {
  REQUIRED
  RECOMMENDED
  INFORMATIONAL
}

enum ExportChecklistStatus {
  PENDING
  COMPLETED
  NOT_APPLICABLE
}

enum ExportAssessmentStatus {
  IN_PROGRESS
  COMPLETED
}

enum StorefrontStatus {
  DRAFT
  APPROVED
  PUBLISHED
}

model Business {
  id           String           @id @default(cuid())
  name         String
  businessType BusinessType
  category     BusinessCategory
  country      String
  city         String
  description  String           @db.Text
  email        String
  phone        String?
  website      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products                   Product[]
  exportReadinessAssessments ExportReadinessAssessment[]

  @@index([country])
  @@index([category])
}

model Product {
  id          String  @id @default(cuid())
  businessId  String
  name        String
  description String  @db.Text
  price       Decimal @db.Decimal(12, 2)
  currency    String  @default("INR")
  imageUrl    String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  marketResearches           MarketResearch[]
  localizations              ProductLocalization[]
  pricingScenarios           PricingScenario[]
  exportReadinessAssessments ExportReadinessAssessment[]
  storefronts                Storefront[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
}

model MarketResearch {
  id                   String         @id @default(cuid())
  productId            String
  cacheKey             String?        @unique
  status               ResearchStatus @default(PENDING)
  requestedCountries   String[]
  summary              String?        @db.Text
  recommendedCountry   String?
  recommendationReason String?        @db.Text
  modelUsed            String?
  errorMessage         String?        @db.Text
  completedAt          DateTime?

  product            Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  results            MarketResult[]
  aiUsage            AiUsage[]
  budgetReservations AiBudgetReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([status])
  @@index([createdAt])
}

model MarketResult {
  id                     String   @id @default(cuid())
  researchId             String
  country                String
  countryCode            String
  rank                   Int
  opportunityScore       Int
  scoreBreakdown         Json?
  demandLevel            String
  competitionLevel       String
  targetCustomers        String   @db.Text
  marketRationale        String   @db.Text
  opportunities          String[]
  risks                  String[]
  culturalConsiderations String[]
  suggestedPriceMin      Decimal? @db.Decimal(12, 2)
  suggestedPriceMax      Decimal? @db.Decimal(12, 2)
  suggestedCurrency      String?

  research                   MarketResearch              @relation(fields: [researchId], references: [id], onDelete: Cascade)
  evidence                   MarketEvidence[]
  localizations              ProductLocalization[]
  pricingScenarios           PricingScenario[]
  exportReadinessAssessments ExportReadinessAssessment[]
  storefronts                Storefront[]

  createdAt DateTime @default(now())

  @@unique([researchId, countryCode])
  @@index([researchId])
  @@index([opportunityScore])
}

model MarketEvidence {
  id             String    @id @default(cuid())
  marketResultId String
  title          String
  publisher      String?
  url            String
  claim          String    @db.Text
  sourceType     String?
  publishedAt    DateTime?
  retrievedAt    DateTime  @default(now())

  marketResult MarketResult @relation(fields: [marketResultId], references: [id], onDelete: Cascade)

  @@index([marketResultId])
}

model ProductLocalization {
  id             String         @id @default(cuid())
  productId      String
  marketResultId String
  cacheKey       String?        @unique
  status         ResearchStatus @default(PENDING)

  country     String
  countryCode String
  locale      String

  localizedTitle       String?  @db.Text
  localizedDescription String?  @db.Text
  culturalGuidance     String[]
  seoKeywords          String[]
  marketingMessages    Json?
  faqs                 Json?

  modelUsed     String?
  promptVersion String
  errorMessage  String?   @db.Text
  completedAt   DateTime?

  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketResult MarketResult @relation(fields: [marketResultId], references: [id], onDelete: Cascade)

  aiUsage            AiUsage[]
  budgetReservations AiBudgetReservation[]
  storefronts        Storefront[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([marketResultId])
  @@index([status])
  @@index([createdAt])
}

model AiUsage {
  id             String  @id @default(cuid())
  researchId     String?
  provider       String  @default("anthropic")
  model          String
  operation      String
  localizationId String?

  inputTokens              Int @default(0)
  outputTokens             Int @default(0)
  cacheReadInputTokens     Int @default(0)
  cacheCreationInputTokens Int @default(0)

  estimatedCostUsd Decimal @default(0) @db.Decimal(12, 8)

  createdAt DateTime @default(now())

  research     MarketResearch?      @relation(fields: [researchId], references: [id], onDelete: SetNull)
  localization ProductLocalization? @relation(fields: [localizationId], references: [id], onDelete: SetNull)

  @@index([researchId])
  @@index([model])
  @@index([createdAt])
  @@index([localizationId])
}

model AiBudget {
  id             String   @id @default("global")
  totalBudgetUsd Decimal  @db.Decimal(12, 8)
  spentUsd       Decimal  @default(0) @db.Decimal(12, 8)
  reservedUsd    Decimal  @default(0) @db.Decimal(12, 8)
  updatedAt      DateTime @updatedAt

  reservations AiBudgetReservation[]
}

model AiBudgetReservation {
  id               String                  @id @default(cuid())
  budgetId         String                  @default("global")
  researchId       String?
  localizationId   String?
  estimatedCostUsd Decimal                 @db.Decimal(12, 8)
  actualCostUsd    Decimal?                @db.Decimal(12, 8)
  status           BudgetReservationStatus @default(RESERVED)
  createdAt        DateTime                @default(now())
  expiresAt        DateTime
  settledAt        DateTime?

  budget       AiBudget             @relation(fields: [budgetId], references: [id])
  research     MarketResearch?      @relation(fields: [researchId], references: [id], onDelete: SetNull)
  localization ProductLocalization? @relation(fields: [localizationId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([researchId])
  @@index([localizationId])
}

model PricingScenario {
  id             String @id @default(cuid())
  productId      String
  marketResultId String

  title          String?
  targetCurrency String

  // Target currency units per 1 unit of the product's source currency.
  exchangeRate       Decimal   @db.Decimal(18, 8)
  exchangeRateSource String?
  exchangeRateDate   DateTime?

  // Original user-provided inputs and deterministic calculation breakdown.
  inputs Json
  result Json

  recommendedPrice Decimal @db.Decimal(12, 2)

  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketResult MarketResult @relation(fields: [marketResultId], references: [id], onDelete: Cascade)

  storefronts Storefront[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([marketResultId])
  @@index([createdAt])
}

model ExportRequirement {
  id          String @id @default(cuid())
  title       String
  description String @db.Text

  category ExportRequirementCategory
  priority ExportRequirementPriority

  countryCode       String
  originCountryCode String @default("IN")

  // Uses the existing business category enum.
  productCategory BusinessCategory?

  applicability String? @db.Text

  sourceName      String
  sourceUrl       String   @db.Text
  sourceCheckedAt DateTime

  isActive Boolean @default(true)

  items ExportReadinessItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryCode, productCategory, isActive])
  @@index([category])
}

model ExportReadinessAssessment {
  id String @id @default(cuid())

  businessId     String
  productId      String
  marketResultId String

  status ExportAssessmentStatus @default(IN_PROGRESS)

  totalItems     Int @default(0)
  completedItems Int @default(0)

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketResult MarketResult @relation(fields: [marketResultId], references: [id], onDelete: Cascade)

  items ExportReadinessItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, marketResultId])
  @@index([businessId])
  @@index([marketResultId])
}

model ExportReadinessItem {
  id String @id @default(cuid())

  assessmentId  String
  requirementId String?

  // Snapshot of the requirement at assessment creation.
  title       String
  description String @db.Text

  category ExportRequirementCategory
  priority ExportRequirementPriority

  sourceName      String?
  sourceUrl       String?   @db.Text
  sourceCheckedAt DateTime?

  status ExportChecklistStatus @default(PENDING)

  completedAt DateTime?
  notes       String?   @db.Text

  sortOrder Int @default(0)

  assessment  ExportReadinessAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  requirement ExportRequirement?        @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assessmentId, requirementId])
  @@index([assessmentId, category])
  @@index([status])
}

model Storefront {
  id     String           @id @default(cuid())
  slug   String           @unique
  status StorefrontStatus @default(DRAFT)

  productId         String
  marketResultId    String
  localizationId    String
  pricingScenarioId String

  // Destination and language
  locale      String
  country     String
  countryCode String

  // Snapshot of the product and localized content
  productName          String
  localizedTitle       String
  localizedDescription String  @db.Text
  imageUrl             String?

  // Snapshot of the seller
  businessName        String
  businessDescription String @db.Text
  businessCity        String
  businessCountry     String

  // Snapshot of the saved international price
  currency String
  price    Decimal @db.Decimal(12, 2)

  // Reused localization content
  seoKeywords       String[]
  culturalGuidance  String[]
  marketingMessages Json?
  faqs              Json?

  approvedAt    DateTime?
  publishedAt   DateTime?
  unpublishedAt DateTime?

  product         Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketResult    MarketResult        @relation(fields: [marketResultId], references: [id], onDelete: Cascade)
  localization    ProductLocalization @relation(fields: [localizationId], references: [id], onDelete: Restrict)
  pricingScenario PricingScenario     @relation(fields: [pricingScenarioId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, marketResultId, locale])
  @@index([status])
  @@index([createdAt])
}
