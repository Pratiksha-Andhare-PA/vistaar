
generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BusinessType {
  INDIVIDUAL
  REGISTERED_BUSINESS
  COOPERATIVE
  ARTISAN_GROUP
}

enum BusinessCategory {
  HANDLOOM
  JEWELLERY
  HANDICRAFTS
  APPAREL
  HOME_DECOR
  ORGANIC_PRODUCTS
  OTHER
}

enum ResearchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Business {
  id           String         @id @default(cuid())
  name         String
  businessType BusinessType
  category     BusinessCategory
  country      String
  city         String
  description  String         @db.Text
  email        String
  phone        String?
  website      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([country])
  @@index([category])
}

model Product {
  id          String  @id @default(cuid())
  businessId  String
  name        String
  description String  @db.Text
  price       Decimal @db.Decimal(12, 2)
  currency    String  @default("INR")
  imageUrl    String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  marketResearches MarketResearch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
}

model MarketResearch {
  id                   String         @id @default(cuid())
  productId            String
  status               ResearchStatus @default(PENDING)
  requestedCountries   String[]
  summary              String?        @db.Text
  recommendedCountry   String?
  recommendationReason String?        @db.Text
  modelUsed            String?
  errorMessage         String?        @db.Text
  completedAt          DateTime?

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  results MarketResult[]
  aiUsage AiUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([status])
  @@index([createdAt])
}

model MarketResult {
  id                     String   @id @default(cuid())
  researchId             String
  country                String
  countryCode            String
  rank                   Int
  opportunityScore       Int
  demandLevel            String
  competitionLevel       String
  targetCustomers        String   @db.Text
  marketRationale        String   @db.Text
  opportunities          String[]
  risks                  String[]
  culturalConsiderations String[]
  suggestedPriceMin      Decimal? @db.Decimal(12, 2)
  suggestedPriceMax      Decimal? @db.Decimal(12, 2)
  suggestedCurrency      String?

  research MarketResearch  @relation(fields: [researchId], references: [id], onDelete: Cascade)
  evidence MarketEvidence[]

  createdAt DateTime @default(now())

  @@unique([researchId, countryCode])
  @@index([researchId])
  @@index([opportunityScore])
}

model MarketEvidence {
  id             String   @id @default(cuid())
  marketResultId String
  title          String
  publisher      String?
  url            String
  claim          String   @db.Text
  sourceType     String?
  publishedAt    DateTime?
  retrievedAt    DateTime @default(now())

  marketResult MarketResult @relation(fields: [marketResultId], references: [id], onDelete: Cascade)

  @@index([marketResultId])
}

model AiUsage {
  id                       String   @id @default(cuid())
  researchId               String?
  provider                 String   @default("anthropic")
  model                    String
  operation                String

  inputTokens              Int      @default(0)
  outputTokens             Int      @default(0)
  cacheReadInputTokens     Int      @default(0)
  cacheCreationInputTokens Int      @default(0)

  estimatedCostUsd         Decimal  @default(0) @db.Decimal(12, 8)

  createdAt DateTime @default(now())

  research MarketResearch? @relation(fields: [researchId], references: [id], onDelete: SetNull)

  @@index([researchId])
  @@index([model])
  @@index([createdAt])
}
